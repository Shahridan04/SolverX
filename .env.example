# SolverX Environment Variables Reference
# Copy these values into your Vercel Project Settings -> Environment Variables

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Lead capture & Admin telemetry)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin Portal Access (/admin)
ADMIN_SECRET=your_admin_password_here
